    "RQ6": {
      "estimand": "Policy and model-ranking stability under predeclared workload/topology change",
      "fields": [
        "TopologySnapshot.payload.snapshot_id",
        "CalibrationModelArtifact.payload.model_validity_domain",
        "CalibrationModelArtifact.payload.unseen_condition_validation",
        "StatisticalAnalysisArtifact.payload.secondary_analyses.rq6_stability[*].change_class",
        "StatisticalAnalysisArtifact.payload.secondary_analyses.rq6_stability[*].policy_rank_correlation",
        "StatisticalAnalysisArtifact.payload.secondary_analyses.rq6_stability[*].candidate_cost_rank_correlation",
        "StatisticalAnalysisArtifact.payload.secondary_analyses.rq6_stability[*].top_choice_accuracy",
        "StatisticalAnalysisArtifact.payload.secondary_analyses.rq6_stability[*].regret"
      ]
