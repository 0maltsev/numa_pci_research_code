        "LocationQualifiedObject.payload.observed_distribution",
        "StatisticalAnalysisArtifact.payload.key_secondary.rq2_b2_b1.mean_log_ratio",
        "StatisticalAnalysisArtifact.payload.key_secondary.rq2_b2_b1.absolute_difference",
        "StatisticalAnalysisArtifact.payload.key_secondary.rq2_b2_b1.holm_adjusted_p_value"
      ]
    },
