        "PageEquivalenceRecord.payload.state",
        "AggregatedDataset.payload.page_equivalence_records[*].E_mem_j",
        "AggregatedDataset.payload.adjacent_pair_indicators[*].A_1_0",
        "AggregatedDataset.payload.runs[*].quantiles.p999",
        "StatisticalAnalysisArtifact.payload.key_secondary.rq1_b1_b0.mean_log_ratio",
        "StatisticalAnalysisArtifact.payload.key_secondary.rq1_b1_b0.absolute_difference",
        "StatisticalAnalysisArtifact.payload.key_secondary.rq1_b1_b0.holm_adjusted_p_value"
      ]
    },
    "RQ2": {
      "estimand": "Accepted-pair B2/B1 memory-binding increment",
      "fields": [
        "AcceptanceRecord.payload.A_bj",
        "AggregatedDataset.payload.adjacent_pair_indicators[*].A_2_1",
        "AggregatedDataset.payload.runs[*].quantiles.p999",
