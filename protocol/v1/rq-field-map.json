  "mandatory_operational_outputs": {
    "policy_attempt_acceptance": "AggregatedDataset.payload.attrition[*].accepted_count",
    "adjacent_pair_completion": "AggregatedDataset.payload.adjacent_pair_indicators",
    "policy_failure_categories": "AggregatedDataset.payload.attrition[*].failure_category",
    "policy_failure_rates": "AggregatedDataset.payload.attrition[*].failure_rate",
    "incomplete_block_policy": "AggregatedDataset.payload.attrition[*].incomplete_block_policy",
    "scientific_exclusion": "AggregatedDataset.payload.runs[*].scientifically_excluded",
    "primary_operational_report": "StatisticalAnalysisArtifact.payload.operational_feasibility"
  }
