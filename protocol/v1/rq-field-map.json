        "StatisticalAnalysisArtifact.payload.primary.decision"
      ]
    },
    "RQ4": {
      "estimand": "Workload modification of the three adjacent placement increments",
      "fields": [
        "WorkloadSpec.payload.packet_bytes",
        "WorkloadSpec.payload.resolved_packet_rate",
        "WorkloadSpec.payload.burst_model",
        "WorkloadSpec.payload.flow_distribution",
        "WorkloadSpec.payload.queue_count",
        "WorkloadSpec.payload.worker_count",
        "StatisticalAnalysisArtifact.payload.secondary_analyses.rq4_interactions[*].factor",
        "StatisticalAnalysisArtifact.payload.secondary_analyses.rq4_interactions[*].incremental_contrast",
        "StatisticalAnalysisArtifact.payload.secondary_analyses.rq4_interactions[*].estimate"
      ]
    },
    "RQ5": {
      "estimand": "Placement/response changes after owned cost-term ablation and explanatory association",
      "fields": [
        "CostTermValue.payload.term_id",
        "CostTermValue.payload.physical_mechanism",
        "CostTermValue.payload.normalized_value",
        "PlacementPlan.payload.assignments",
        "TelemetryRecord.payload.extended_value",
        "CalibrationModelArtifact.payload.effective_coefficients",
        "CalibrationModelArtifact.payload.seen_condition_validation",
        "CalibrationModelArtifact.payload.unseen_condition_validation",
        "StatisticalAnalysisArtifact.payload.secondary_analyses.rq5_model_explanation[*].p999_effect",
        "StatisticalAnalysisArtifact.payload.secondary_analyses.rq5_model_explanation[*].counter_association",
        "StatisticalAnalysisArtifact.payload.secondary_analyses.rq5_model_explanation[*].held_out_rank"
