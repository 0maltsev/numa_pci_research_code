        "StatisticalAnalysisArtifact.payload.primary.reference_condition_id",
        "StatisticalAnalysisArtifact.payload.primary.accepted_pair_ids",
        "StatisticalAnalysisArtifact.payload.primary.D_j",
        "StatisticalAnalysisArtifact.payload.primary.mean_D",
        "StatisticalAnalysisArtifact.payload.primary.standard_error",
        "StatisticalAnalysisArtifact.payload.primary.t_statistic",
        "StatisticalAnalysisArtifact.payload.primary.one_sided_p_value",
        "StatisticalAnalysisArtifact.payload.primary.upper_one_sided_95_bound",
        "StatisticalAnalysisArtifact.payload.primary.two_sided_95_lower",
