{
  "$id": "https://numa-pcie-research.invalid/schemas/v1/acceptance-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Performance-blind immutable attempt acceptance and contrast admission.",
  "properties": {
    "meta": {
      "$ref": "common.schema.json#/$defs/recordMetadata"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "A_bj": {
          "type": "boolean"
        },
        "all_failed_gate_ids": {
          "items": {
            "$ref": "common.schema.json#/$defs/nonemptyString"
          },
          "minItems": 0,
          "type": "array"
        },
        "attempt_id": {
          "$ref": "common.schema.json#/$defs/stableId"
        },
        "block_id": {
          "$ref": "common.schema.json#/$defs/stableId"
        },
        "contrast_admission": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "contrast": {
                "enum": [
                  "B1/B0",
                  "B2/B1",
                  "B3/B2"
                ],
                "type": "string"
              },
              "indicator_record_digest": {
                "$ref": "common.schema.json#/$defs/statefulValue"
              },
              "status": {
                "enum": [
                  "Pair-Pending",
                  "Admitted",
                  "Excluded"
                ],
                "type": "string"
              }
            },
            "required": [
              "contrast",
              "status",
              "indicator_record_digest"
            ],
            "type": "object"
          },
          "minItems": 0,
          "type": "array"
        },
        "decision_before_latency_summary": {
          "const": true
        },
        "gates": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "category": {
                "$ref": "common.schema.json#/$defs/nonemptyString"
              },
              "evidence_digest": {
                "$ref": "common.schema.json#/$defs/digest"
              },
              "gate_id": {
                "$ref": "common.schema.json#/$defs/stableId"
              },
              "result": {
                "enum": [
                  "Pass",
                  "Fail",
                  "Unsupported",
                  "NotApplicable"
                ],
                "type": "string"
              }
            },
            "required": [
              "gate_id",
              "category",
              "result",
              "evidence_digest"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "policy": {
          "enum": [
            "B0",
            "B1",
            "B2",
            "B3"
          ],
          "type": "string"
        },
        "primary_failure_category": {
          "$ref": "common.schema.json#/$defs/statefulValue"
        },
        "prospective_pair_keys": {
          "items": {
            "$ref": "common.schema.json#/$defs/nonemptyString"
          },
          "minItems": 0,
          "type": "array"
        }
      },
      "required": [
        "block_id",
        "attempt_id",
        "policy",
        "gates",
        "A_bj",
        "primary_failure_category",
        "all_failed_gate_ids",
        "prospective_pair_keys",
        "contrast_admission",
        "decision_before_latency_summary"
      ],
      "type": "object"
    },
    "record_type": {
      "const": "AcceptanceRecord"
    }
  },
  "required": [
    "meta",
    "record_type",
    "payload"
  ],
  "title": "AcceptanceRecord",
  "type": "object"
}
