{
  "$id": "https://numa-pcie-research.invalid/schemas/v1/capacity-check.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Reproducible hard-capacity inequality.",
  "properties": {
    "meta": {
      "$ref": "common.schema.json#/$defs/recordMetadata"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "calibrated_capacity": {
          "$ref": "common.schema.json#/$defs/quantity"
        },
        "calibration_digest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "contributors": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "contributor_id": {
                "$ref": "common.schema.json#/$defs/stableId"
              },
              "demand": {
                "$ref": "common.schema.json#/$defs/quantity"
              }
            },
            "required": [
              "contributor_id",
              "demand"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "inequality": {
          "$ref": "common.schema.json#/$defs/nonemptyString"
        },
        "resource_id": {
          "$ref": "common.schema.json#/$defs/stableId"
        },
        "resource_type": {
          "$ref": "common.schema.json#/$defs/nonemptyString"
        },
        "result": {
          "enum": [
            "Pass",
            "Fail"
          ],
          "type": "string"
        },
        "safety_guard": {
          "$ref": "common.schema.json#/$defs/quantity"
        },
        "total_demand": {
          "$ref": "common.schema.json#/$defs/quantity"
        }
      },
      "required": [
        "resource_id",
        "resource_type",
        "contributors",
        "calibrated_capacity",
        "safety_guard",
        "total_demand",
        "inequality",
        "result",
        "calibration_digest"
      ],
      "type": "object"
    },
    "record_type": {
      "const": "CapacityCheck"
    }
  },
  "required": [
    "meta",
    "record_type",
    "payload"
  ],
  "title": "CapacityCheck",
  "type": "object"
}
