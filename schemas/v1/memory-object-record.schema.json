{
  "$id": "https://numa-pcie-research.invalid/schemas/v1/memory-object-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Typed material or null memory-object lifecycle record.",
  "properties": {
    "meta": {
      "$ref": "common.schema.json#/$defs/recordMetadata"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "address_span_reference": {
          "$ref": "common.schema.json#/$defs/statefulValue"
        },
        "attempt_id": {
          "$ref": "common.schema.json#/$defs/stableId"
        },
        "element_count": {
          "$ref": "common.schema.json#/$defs/quantity"
        },
        "element_size": {
          "$ref": "common.schema.json#/$defs/quantity"
        },
        "fresh_allocation_proof_digest": {
          "$ref": "common.schema.json#/$defs/statefulValue"
        },
        "lifecycle": {
          "enum": [
            "Declared",
            "Allocated",
            "Faulted",
            "InUse",
            "Destroyed",
            "Null"
          ],
          "type": "string"
        },
        "object": {
          "additionalProperties": false,
          "properties": {
            "accessor_shares": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "owner_id": {
                    "$ref": "common.schema.json#/$defs/stableId"
                  },
                  "share": {
                    "$ref": "common.schema.json#/$defs/quantity"
                  }
                },
                "required": [
                  "owner_id",
                  "share"
                ],
                "type": "object"
              },
              "minItems": 0,
              "type": "array"
            },
            "allocation_actor_id": {
              "$ref": "common.schema.json#/$defs/statefulValue"
            },
            "allowed_node_ids": {
              "items": {
                "$ref": "common.schema.json#/$defs/nonemptyString"
              },
              "minItems": 0,
              "type": "array"
            },
            "backing_source": {
              "$ref": "common.schema.json#/$defs/statefulValue"
            },
            "capacity_bytes": {
              "$ref": "common.schema.json#/$defs/quantity"
            },
            "capacity_slots": {
              "$ref": "common.schema.json#/$defs/quantity"
            },
            "desired_distribution": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "domain_id": {
                    "$ref": "common.schema.json#/$defs/stableId"
                  },
                  "fraction": {
                    "$ref": "common.schema.json#/$defs/quantity"
                  }
                },
                "required": [
                  "domain_id",
                  "fraction"
                ],
                "type": "object"
              },
              "minItems": 1,
              "type": "array"
            },
            "fault_actor_id": {
              "$ref": "common.schema.json#/$defs/statefulValue"
            },
            "materiality": {
              "enum": [
                "Material",
                "Null"
              ],
              "type": "string"
            },
            "object_id": {
              "$ref": "common.schema.json#/$defs/stableId"
            },
            "observation_coverage": {
              "$ref": "common.schema.json#/$defs/quantity"
            },
            "observation_status": {
              "$ref": "common.schema.json#/$defs/nonemptyString"
            },
            "observed_distribution": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "domain_id": {
                    "$ref": "common.schema.json#/$defs/stableId"
                  },
                  "fraction": {
                    "$ref": "common.schema.json#/$defs/quantity"
                  }
                },
                "required": [
                  "domain_id",
                  "fraction"
                ],
                "type": "object"
              },
              "minItems": 1,
              "type": "array"
            },
            "page_size": {
              "$ref": "common.schema.json#/$defs/quantity"
            },
            "requested_policy": {
              "$ref": "common.schema.json#/$defs/statefulValue"
            },
            "role": {
              "enum": [
                "rx_payload",
                "tx_payload",
                "rx_descriptor",
                "tx_descriptor",
                "event_ring",
                "state"
              ],
              "type": "string"
            },
            "used_bytes": {
              "$ref": "common.schema.json#/$defs/quantity"
            }
          },
          "required": [
            "object_id",
            "role",
            "materiality",
            "capacity_bytes",
            "used_bytes",
            "capacity_slots",
            "page_size",
            "backing_source",
            "desired_distribution",
            "requested_policy",
            "allowed_node_ids",
            "allocation_actor_id",
            "fault_actor_id",
            "accessor_shares",
            "observed_distribution",
            "observation_coverage",
            "observation_status"
          ],
          "type": "object"
        },
        "reserved_bytes": {
          "$ref": "common.schema.json#/$defs/quantity"
        },
        "teardown_proof_digest": {
          "$ref": "common.schema.json#/$defs/statefulValue"
        },
        "usable_bytes": {
          "$ref": "common.schema.json#/$defs/quantity"
        }
      },
      "required": [
        "attempt_id",
        "object",
        "address_span_reference",
        "usable_bytes",
        "reserved_bytes",
        "element_size",
        "element_count",
        "lifecycle",
        "fresh_allocation_proof_digest",
        "teardown_proof_digest"
      ],
      "type": "object"
    },
    "record_type": {
      "const": "MemoryObjectRecord"
    }
  },
  "required": [
    "meta",
    "record_type",
    "payload"
  ],
  "title": "MemoryObjectRecord",
  "type": "object"
}
