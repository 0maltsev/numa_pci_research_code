{
  "$id": "https://numa-pcie-research.invalid/schemas/v1/observed-placement.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Independent desired/requested/applied/observed placement validation.",
  "properties": {
    "meta": {
      "$ref": "common.schema.json#/$defs/recordMetadata"
    },
    "payload": {
      "additionalProperties": false,
      "properties": {
        "applied_placement_digest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "attempt_id": {
          "$ref": "common.schema.json#/$defs/stableId"
        },
        "ownership_observations": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "acceptance_range_result": {
                "enum": [
                  "Pass",
                  "Fail",
                  "Unsupported"
                ],
                "type": "string"
              },
              "applied_claim": {
                "$ref": "common.schema.json#/$defs/statefulValue"
              },
              "catalog_entry_index": {
                "$ref": "common.schema.json#/$defs/stableId"
              },
              "control_class": {
                "$ref": "common.schema.json#/$defs/nonemptyString"
              },
              "coverage": {
                "$ref": "common.schema.json#/$defs/quantity"
              },
              "desired_share": {
                "$ref": "common.schema.json#/$defs/quantity"
              },
              "observed_shares": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "owner_id": {
                      "$ref": "common.schema.json#/$defs/stableId"
                    },
                    "share": {
                      "$ref": "common.schema.json#/$defs/quantity"
                    }
                  },
                  "required": [
                    "owner_id",
                    "share"
                  ],
                  "type": "object"
                },
                "minItems": 0,
                "type": "array"
              },
              "queue_id": {
                "$ref": "common.schema.json#/$defs/stableId"
              },
              "requested_action": {
                "$ref": "common.schema.json#/$defs/statefulValue"
              }
            },
            "required": [
              "queue_id",
              "catalog_entry_index",
              "control_class",
              "desired_share",
              "requested_action",
              "applied_claim",
              "observed_shares",
              "coverage",
              "acceptance_range_result"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "page_observations": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "accessor_shares": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "owner_id": {
                      "$ref": "common.schema.json#/$defs/stableId"
                    },
                    "share": {
                      "$ref": "common.schema.json#/$defs/quantity"
                    }
                  },
                  "required": [
                    "owner_id",
                    "share"
                  ],
                  "type": "object"
                },
                "minItems": 0,
                "type": "array"
              },
              "allocation_actor_id": {
                "$ref": "common.schema.json#/$defs/statefulValue"
              },
              "allowed_node_ids": {
                "items": {
                  "$ref": "common.schema.json#/$defs/nonemptyString"
                },
                "minItems": 0,
                "type": "array"
              },
              "backing_source": {
                "$ref": "common.schema.json#/$defs/statefulValue"
              },
              "capacity_bytes": {
                "$ref": "common.schema.json#/$defs/quantity"
              },
              "capacity_slots": {
                "$ref": "common.schema.json#/$defs/quantity"
              },
              "desired_distribution": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "domain_id": {
                      "$ref": "common.schema.json#/$defs/stableId"
                    },
                    "fraction": {
                      "$ref": "common.schema.json#/$defs/quantity"
                    }
                  },
                  "required": [
                    "domain_id",
                    "fraction"
                  ],
                  "type": "object"
                },
                "minItems": 1,
                "type": "array"
              },
              "fault_actor_id": {
                "$ref": "common.schema.json#/$defs/statefulValue"
              },
              "materiality": {
                "enum": [
                  "Material",
                  "Null"
                ],
                "type": "string"
              },
              "object_id": {
                "$ref": "common.schema.json#/$defs/stableId"
              },
              "observation_coverage": {
                "$ref": "common.schema.json#/$defs/quantity"
              },
              "observation_status": {
                "$ref": "common.schema.json#/$defs/nonemptyString"
              },
              "observed_distribution": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "domain_id": {
                      "$ref": "common.schema.json#/$defs/stableId"
                    },
                    "fraction": {
                      "$ref": "common.schema.json#/$defs/quantity"
                    }
                  },
                  "required": [
                    "domain_id",
                    "fraction"
                  ],
                  "type": "object"
                },
                "minItems": 1,
                "type": "array"
              },
              "page_size": {
                "$ref": "common.schema.json#/$defs/quantity"
              },
              "requested_policy": {
                "$ref": "common.schema.json#/$defs/statefulValue"
              },
              "role": {
                "enum": [
                  "rx_payload",
                  "tx_payload",
                  "rx_descriptor",
                  "tx_descriptor",
                  "event_ring",
                  "state"
                ],
                "type": "string"
              },
              "used_bytes": {
                "$ref": "common.schema.json#/$defs/quantity"
              }
            },
            "required": [
              "object_id",
              "role",
              "materiality",
              "capacity_bytes",
              "used_bytes",
              "capacity_slots",
              "page_size",
              "backing_source",
              "desired_distribution",
              "requested_policy",
              "allowed_node_ids",
              "allocation_actor_id",
              "fault_actor_id",
              "accessor_shares",
              "observed_distribution",
              "observation_coverage",
              "observation_status"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "placement_deltas": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "match_status": {
                "$ref": "common.schema.json#/$defs/nonemptyString"
              },
              "state": {
                "additionalProperties": false,
                "properties": {
                  "applied": {
                    "$ref": "common.schema.json#/$defs/statefulValue"
                  },
                  "desired": {
                    "$ref": "common.schema.json#/$defs/statefulValue"
                  },
                  "observed": {
                    "$ref": "common.schema.json#/$defs/statefulValue"
                  },
                  "requested": {
                    "$ref": "common.schema.json#/$defs/statefulValue"
                  }
                },
                "required": [
                  "desired",
                  "requested",
                  "applied",
                  "observed"
                ],
                "type": "object"
              },
              "subject_id": {
                "$ref": "common.schema.json#/$defs/stableId"
              }
            },
            "required": [
              "subject_id",
              "state",
              "match_status"
            ],
            "type": "object"
          },
          "minItems": 0,
          "type": "array"
        },
        "plan_digest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "role_context_cpu_observations": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "context_id": {
                "$ref": "common.schema.json#/$defs/stableId"
              },
              "coverage": {
                "$ref": "common.schema.json#/$defs/quantity"
              },
              "effective_cpu_mask": {
                "$ref": "common.schema.json#/$defs/statefulValue"
              },
              "observed_cpu_ids": {
                "items": {
                  "$ref": "common.schema.json#/$defs/nonemptyString"
                },
                "minItems": 0,
                "type": "array"
              },
              "requested_cpu_mask": {
                "$ref": "common.schema.json#/$defs/statefulValue"
              },
              "role_id": {
                "$ref": "common.schema.json#/$defs/stableId"
              },
              "thread_id": {
                "$ref": "common.schema.json#/$defs/stableId"
              }
            },
            "required": [
              "role_id",
              "context_id",
              "thread_id",
              "requested_cpu_mask",
              "effective_cpu_mask",
              "observed_cpu_ids",
              "coverage"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "validation_status": {
          "enum": [
            "Pass",
            "Placement-Mismatch",
            "Share-Out-Of-Range",
            "Observation-Incomplete"
          ],
          "type": "string"
        }
      },
      "required": [
        "attempt_id",
        "plan_digest",
        "applied_placement_digest",
        "role_context_cpu_observations",
        "page_observations",
        "ownership_observations",
        "placement_deltas",
        "validation_status"
      ],
      "type": "object"
    },
    "record_type": {
      "const": "ObservedPlacement"
    }
  },
  "required": [
    "meta",
    "record_type",
    "payload"
  ],
  "title": "ObservedPlacement",
  "type": "object"
}
